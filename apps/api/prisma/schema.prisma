generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum TenantPlan {
  free
  pro
  agency
}

enum UserRole {
  owner
  admin
  member
}

enum StatusType {
  unknown
  pass
  fail
  warn
}

enum SeverityType {
  critical
  warning
  info
}

enum SuppressionEventType {
  unsubscribe
  spam_complaint
  bounce
}

//
// TENANTS
//

model Tenant {
  id             String      @id @default(uuid())
  name           String
  plan           TenantPlan  @default(free)
  lsCustomerId   String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  users              User[]
  domains            Domain[]
  changeEvents       DnsChangeEvent[]
  emailAnalyses      EmailAnalysis[]
  suppressionEvents  SuppressionEvent[]
  aiUsageLogs        AiUsageLog[]
  auditLogs          AuditLog[]
  unsubscribeTokens  UnsubscribeToken[]

  @@map("tenants")
}

//
// USERS
//

model User {
  id         String     @id @default(uuid())

  clerkId    String     @unique
  email      String

  role       UserRole   @default(member)

  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@map("users")

  @@index([clerkId])
  @@index([tenantId])

  @@unique([tenantId, email])
}

//
// DOMAINS
//

model Domain {
  id              String      @id @default(uuid())

  domain          String

  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  spfStatus       StatusType  @default(unknown)
  dkimStatus      StatusType  @default(unknown)
  dmarcStatus     StatusType  @default(unknown)
  unsubStatus     StatusType  @default(unknown)

  healthScore     Int         @default(0)

  detectedEsp     String?

  lastCheckedAt   DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  snapshots           DnsSnapshot[]
  changeEvents        DnsChangeEvent[]
  emailAnalyses       EmailAnalysis[]
  suppressionEvents   SuppressionEvent[]
  unsubscribeTokens   UnsubscribeToken[]

  @@map("domains")

  @@unique([tenantId, domain])
  @@index([tenantId])
}

//
// DNS SNAPSHOTS
//

model DnsSnapshot {
  id                String     @id @default(uuid())

  domainId          String
  domain            Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)

  spfRecord         String?
  spfLookupCount    Int?
  spfResult         String?

  dkimSelectors     Json?

  dmarcRecord       String?
  dmarcPolicy       String?
  dmarcPct          Int?

  overallScore      Int        @default(0)

  capturedAt        DateTime   @default(now())

  @@map("dns_snapshots")

  @@index([domainId, capturedAt(sort: Desc)])
}

//
// DNS CHANGE EVENTS
//

model DnsChangeEvent {
  id               String        @id @default(uuid())

  domainId         String
  domain           Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)

  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  changeType       String

  severity         SeverityType

  previousValue    String?
  currentValue     String?

  aiTitle          String?
  aiSummary        String?
  aiFixSteps       Json?

  acknowledged     Boolean       @default(false)
  resolvedAt       DateTime?

  detectedAt       DateTime      @default(now())

  @@map("dns_change_events")

  @@index([tenantId, detectedAt(sort: Desc)])
  @@index([domainId])
}

//
// EMAIL ANALYSES
//

model EmailAnalysis {
  id                  String      @id @default(uuid())

  domainId            String
  domain              Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)

  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parsedResult        Json

  aiDiagnosis         String?

  espDetected         String?
  espConfidence       Float?

  overallScore        Int         @default(0)

  receivedAt          DateTime    @default(now())

  rawHeadersDeletedAt DateTime?

  @@map("email_analyses")

  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([domainId])
}

//
// SUPPRESSION EVENTS
//

model SuppressionEvent {
  id            String                 @id @default(uuid())

  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  domainId      String
  domain        Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)

  emailHash     String

  eventType     SuppressionEventType

  sourceEsp     String?

  occurredAt    DateTime
  processedAt   DateTime               @default(now())

  @@map("suppression_events")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([domainId])
}

//
// UNSUBSCRIBE TOKENS
//

model UnsubscribeToken {
  id              String      @id @default(uuid())

  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  domainId        String
  domain          Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)

  tokenHash       String      @unique

  recipientHash   String

  usedAt          DateTime?

  createdAt       DateTime    @default(now())

  @@map("unsubscribe_tokens")

  @@index([domainId])
}

//
// AI USAGE LOGS
//

model AiUsageLog {
  id             String      @id @default(uuid())

  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feature        String

  model          String

  inputTokens    Int?
  outputTokens   Int?

  costUsd        Float?

  createdAt      DateTime    @default(now())

  @@map("ai_usage_logs")

  @@index([tenantId, createdAt(sort: Desc)])
}

//
// AUDIT LOGS
//

model AuditLog {
  id              String      @id @default(uuid())

  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId          String?

  action          String

  resourceType    String?
  resourceId      String?

  metadata        Json?

  ipAddress       String?

  createdAt       DateTime    @default(now())

  @@map("audit_logs")

  @@index([tenantId, createdAt(sort: Desc)])
}